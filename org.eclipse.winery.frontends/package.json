{
    "name": "winery-frontends",
    "version": "3.0.0-SNAPSHOT",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start-tosca-management": "ng serve tosca-management --host 0.0.0.0",
        "start-topologymodeler": "ng serve topologymodeler --host 0.0.0.0",
        "start-workflowmodeler": "ng serve workflowmodeler",
        "build-tosca-management": "ng build tosca-management",
        "build-topologymodeler": "ng build topologymodeler",
        "build-workflowmodeler": "ng build workflowmodeler",
        "build-tosca-management-prod": "ng build tosca-management --prod",
        "build-topologymodeler-prod": "ng build topologymodeler --prod",
        "build-workflowmodeler-prod": "ng build workflowmodeler --prod",
        "lint-tosca-management": "ng lint tosca-management",
        "lint-topologymodeler": "ng lint topologymodeler",
        "lint-workflowmodeler": "ng lint workflowmodeler",
        "doc-tosca-management": "typedoc --options tosca-management/src/typedoc.json --exclude '**/*.spec.ts' ./tosca-management/src/",
        "doc-topologymodeler": "typedoc --options topologymodeler/src/typedoc.json --exclude '**/*.spec.ts' ./topologymodeler/src/",
        "doc-workflowmodeler": "typedoc --options workflowmodeler/src/typedoc.json --exclude '**/*.spec.ts' ./worklfowmodeler/src/"
    },
